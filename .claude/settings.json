{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "gh *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.config/git/credentials",
        "~/.netrc",
        "~/Library/Keychains"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git push -u origin HEAD:refs/heads/build/*)",
      "Bash(git push -u origin HEAD:refs/heads/fix/*)",
      "Bash(git push -u origin HEAD:refs/heads/spike/*)",
      "Bash(git push origin --delete spike/*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/Library/Keychains/**)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git commit *--amend*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)"
    ]
  }
}
